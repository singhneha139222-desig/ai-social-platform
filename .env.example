# ============================================
# AI-Driven Social Media Platform
# Environment Configuration Example
# ============================================
# Copy this file to .env in each service directory
# and fill in the actual values.
# NEVER commit .env files with real secrets.

# --- Backend (backend/.env) ---
PORT=5000
MONGODB_URI=mongodb://localhost:27017/ai-social-platform
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d
AI_SERVICE_URL=http://localhost:5001
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Cloudinary (Media Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP Config (OTP Emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password


# --- AI Service (services/ai-service/.env) ---
AI_PORT=5001
TOXICITY_MODEL=unitary/toxic-bert
SENTIMENT_MODEL=lxyuan/distilbert-base-multilingual-cased-sentiments-student
DEVICE=cpu
MODEL_CACHE_DIR=./models_cache

# --- Frontend (frontend/.env) ---
VITE_API_URL=http://localhost:5000/api/v1
