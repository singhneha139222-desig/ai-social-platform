    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "file-type": "^16.5.4",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^8.8.0",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "multer-storage-cloudinary": "^4.0.0",
